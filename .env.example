# Copia este archivo como .env y pon tus propios valores. El archivo .env no se sube a GitHub.
DB_URL=jdbc:mysql://localhost:3306/tienda_bicicletas
DB_USERNAME=root
DB_PASSWORD=cambia-esta-contraseña

# Clave para firmar los tokens JWT: mínimo 32 caracteres aleatorios
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Contraseñas de los usuarios iniciales que crea la aplicación
ADMIN_PASSWORD=cambia-esta-contraseña
TRABAJADOR_PASSWORD=cambia-esta-contraseña
